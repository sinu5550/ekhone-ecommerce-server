model Shipment {
  id               Int            @id @default(autoincrement())
  orderId          Int            @unique
  order            OnlineOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier          String         @default("STEADFAST")
  consignmentId    String?
  trackingCode     String?        @unique
  invoiceNumber    String
  recipientName    String
  recipientPhone   String
  recipientAddress String
  codAmount        Decimal        @db.Decimal(10, 2)
  courierStatus    String         @default("pending")
  status           ShipmentStatus @default(Pending)
  isStockRestored  Boolean        @default(false)
  stockRestoredAt  DateTime?
  deliveryType     Int            @default(0)
  note             String?
  metadata         Json?
  courierCharge    Decimal?       @default(0) @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  accountTransactions AccountTransaction[]

  @@index([orderId])
  @@index([consignmentId])
  @@index([trackingCode])
  @@index([status])
  @@map("Shipments")
}

enum ShipmentStatus {
  Pending
  InReview
  Dispatched
  InTransit
  Delivered
  PartialDelivered
  Cancelled
  Returned
  Hold
}

// ==========================================
//           ACCOUNTING MODULE
// ==========================================

enum AccountHeadType {
  INCOME
  EXPENSE
}

model AccountHead {
  id          Int             @id @default(autoincrement())
  code        String          @unique
  title       String          @unique
  type        AccountHeadType
  description String?
  status      Boolean         @default(true)
  isSystem    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  transactions AccountTransaction[]

  @@index([type])
  @@index([status])
  @@map("AccountHeads")
}

model AccountTransaction {
  id            Int             @id @default(autoincrement())
  voucherNo     String          @unique
  type          AccountHeadType
  accountHeadId Int
  accountHead   AccountHead     @relation(fields: [accountHeadId], references: [id], onDelete: Restrict)
  amount        Decimal         @db.Decimal(10, 2)
  date          DateTime        @default(now())
  paymentMethod String          @default("Cash")
  reference     String?
  note          String?         @db.Text
  attachment    String?
  orderId       Int?
  order         OnlineOrder?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shipmentId    Int?
  shipment      Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([type])
  @@index([accountHeadId])
  @@index([date])
  @@index([orderId])
  @@index([shipmentId])
  @@map("AccountTransactions")
}

model LandingPage {
  id                    Int       @id @default(autoincrement())
  productId             Int
  product               Product   @relation("LandingMainProduct", fields: [productId], references: [id], onDelete: Cascade)
  
  // Order Bump Add-on Product configuration
  orderBumpProductId    Int?
  orderBumpProduct      Product?  @relation("LandingOrderBumpProduct", fields: [orderBumpProductId], references: [id], onDelete: SetNull)
  orderBumpTitle        String?   // Custom promotional title e.g. "স্পেশাল অফার: সাথে নিন আমাদের প্রিমিয়াম ঘি"
  orderBumpSubtitle     String?   // Short persuasion copy e.g. "মূল পণ্যের সাথে নিলে পাচ্ছেন অতিরিক্ত ২০০ টাকা বিশেষ ছাড়!"
  orderBumpDiscount     Decimal?  @default(0.00) @db.Decimal(10, 2) // Extra discount when bump product is selected
  orderBumpPrice        Decimal?  @db.Decimal(10, 2) // Optional custom bump price (defaults to product salePrice)

  slug                  String    @unique
  pageTitle             String    // Headline, e.g. "প্রতিদিনের রান্নায় আনুন খাঁটি ঘ্রাণ ও স্বাদ"
  subTitle              String?   @db.Text // Tagline / hook
  badgeText             String?   // e.g. "১০০% খাঁটি ও নিরাপদ"
  videoUrl              String?   // YouTube embed or Cloudinary video link
  bannerImages          Json?     // Array of gallery image URLs
  whyChooseUsTitle      String?   @default("কেন আমাদের পণ্য সেরা?")
  features              Json?     // [{ title, desc, icon }]
  trustPoints           Json?     // [{ title, desc }] or string[]
  variantDiscounts      Json?     // { "<variantId>": discountAmountInTaka }
  highlightsTitle       String?   @default("পণ্যটির আকর্ষণীয় ব্যবহার ও বৈশিষ্ট্য")
  highlights            Json?     // [{ title, image, desc }]
  reviews               Json?     // [{ name, rating, comment, date }]
  insideDhakaDelivery   Decimal?  @default(70.00) @db.Decimal(10, 2)
  outsideDhakaDelivery  Decimal?  @default(130.00) @db.Decimal(10, 2)
  offerPrice            Decimal?  @db.Decimal(10, 2) // Optional campaign special discount price
  urgencyText           String?   @default("অফারটি সীমিত সময়ের জন্য! এখনই অর্ডার করুন")
  fakeOrderCounter      Int?      @default(120) // Display count e.g. "১২০ জন ইতিমধ্যে অর্ডার করেছেন"
  themeColor            String?   @default("#F45116")
  isPublished           Boolean   @default(true)
  viewsCount            Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([slug])
  @@index([productId])
  @@index([orderBumpProductId])
  @@map("LandingPages")
}


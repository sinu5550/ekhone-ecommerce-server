generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id     String      @id @default(uuid())
  name   String
  email  String      @unique
  authId String?
  status AdminStatus @default(Active)

  roleId String
  role   AdminRole @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminRole {
  id   String @id @default(uuid())
  name String @unique

  users       AdminUser[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id     String @id @default(uuid())
  module String
  action String
  slug   String @unique

  roles RolePermission[]

  createdAt DateTime @default(now())
}

model RolePermission {
  id String @id @default(uuid())

  roleId       String
  permissionId String

  role       AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Sequence {
  id            Int      @id @default(autoincrement())
  type          String   @unique
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model MainCategory {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  name        String     @unique
  image       String
  description String?
  status      Boolean    @default(true)
  priority    Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  categories  Category[]

  @@index([status])
  @@index([name])
}

model Category {
  id                 Int                @id @default(autoincrement())
  code               String             @unique
  name               String
  image              String
  mainCategoryId     Int
  status             Boolean            @default(true)
  priority           Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  mainCategory       MainCategory       @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  couponCategories   CouponCategory[]
  discountCategories DiscountCategory[]
  subCategories      SubCategory[]

  @@unique([mainCategoryId, name])
  @@index([mainCategoryId])
  @@index([status])
}

model SubCategory {
  id                    Int                   @id @default(autoincrement())
  code                  String                @unique
  name                  String
  categoryId            Int
  status                Boolean               @default(true)
  priority              Int                   @default(1)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  discountSubCategories DiscountSubCategory[]
  Product               Product[]
  category              Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([status])
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  image     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name])
}

model Unit {
  id        Int       @id @default(autoincrement())
  name      String
  shortName String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model VariantAttributes {
  id        Int       @id @default(autoincrement())
  variant   String
  values    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Warranty {
  id          Int       @id @default(autoincrement())
  name        String?
  duration    Int?
  period      String
  description String?
  status      Boolean   @default(true)
  products    Product[]
}

model Product {
  id                         Int       @id @default(autoincrement())
  slug                       String    @unique
  sku                        String?
  productName                String
  sellingType                String?
  subCategoryId              Int
  brandId                    Int?
  unitId                     Int?
  store                      String?
  warehouse                  String?
  warrantyId                 Int?
  price                      Decimal   @db.Decimal(10, 2)
  quantity                   Int       @default(0)
  images                     Json?
  description                String?
  taxType                    String?
  tax                        Float?
  discountType               String?
  discountValue              Int?      @default(0)
  quantityAlert              Int?
  manufacturer               String?
  manufacturerData           DateTime?
  expireOn                   DateTime?
  variantAttributesId        Int?
  visibility                 String    @default("public")
  status                     Boolean   @default(true)
  isArchived                 Boolean   @default(false)
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime? @updatedAt
  productType                String?   @default("single")
  insideDhakaDeliveryCharge  Decimal?  @db.Decimal(10, 2)
  outsideDhakaDeliveryCharge Decimal?  @db.Decimal(10, 2)
  costPrice                  Decimal?  @default(0) @db.Decimal(10, 2)

  bundleItems       BundleItem[]
  couponProducts    CouponProduct[]
  discountProducts  DiscountProduct[]
  orderItems        OrderItem[]
  brand             Brand?              @relation(fields: [brandId], references: [id])
  subCategory       SubCategory         @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  unit              Unit?               @relation(fields: [unitId], references: [id])
  VariantAttributes VariantAttributes?  @relation(fields: [variantAttributesId], references: [id])
  warranty          Warranty?           @relation(fields: [warrantyId], references: [id])
  wishlists         Wishlist[]
  productVariants   ProductVariant[]
  collections       ProductCollection[]
  landingPages      LandingPage[]       @relation("LandingMainProduct")
  landingOrderBumps LandingPage[]       @relation("LandingOrderBumpProduct")
  heroSliders       HeroSlider[]

  @@index([productName])
  @@index([sku])
  @@index([status, createdAt])
  @@index([subCategoryId])
  @@index([brandId])
}

model Collection {
  id        Int                 @id @default(autoincrement())
  name      String              @unique
  slug      String              @unique
  status    Boolean             @default(true)
  priority  Int                 @default(1)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  ProductCollection[]

  @@index([status])
  @@index([slug])
  @@index([name])
}

model ProductCollection {
  id           Int        @id @default(autoincrement())
  productId    Int
  collectionId Int
  createdAt    DateTime   @default(now())
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@index([productId])
  @@index([collectionId])
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  sku        String      @unique
  price      Decimal     @db.Decimal(10, 2)
  costPrice  Decimal?    @default(0) @db.Decimal(10, 2)
  quantity   Int         @default(0)
  attributes Json
  image      String?
  isDefault  Boolean     @default(false)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([sku])
}

model Customer {
  id            Int            @id @default(autoincrement())
  customerCode  String         @unique
  fullName      String
  email         String?        @unique
  phone         String
  status        Boolean        @default(true)
  loyaltyPoints LoyaltyPoints?

  // Relations
  customerAddresses   CustomerAddress[]
  onlineOrders        OnlineOrder[]
  invoices            Invoice[]
  saleReturns         SaleReturn[]
  payments            Payment[]
  wishlists           Wishlist[]
  loyaltyTransactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([phone])
}

model CustomerAddress {
  id            Int      @id @default(autoincrement())
  customerId    Int
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recipientName String?
  phoneNumber   String?
  address       String
  upazila       String
  postalCode    String?
  district      String
  division      String
  city          String?
  country       String   @default("Bangladesh")
  type          String   @default("Home")

  isDefault Boolean @default(false)

  // Add relation to orders
  orders OnlineOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]

  @@index([customerId])
}

model BundleOrderItem {
  id            Int           @id @default(autoincrement())
  onlineOrderId Int?
  bundleId      Int
  bundle        BundleProduct @relation(fields: [bundleId], references: [id], onDelete: NoAction)
  quantity      Int
  unitPrice     Decimal       @db.Decimal(10, 2)
  discount      Decimal?      @db.Decimal(10, 2)
  tax           Decimal?      @db.Decimal(10, 2)
  lineTotal     Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  onlineOrder   OnlineOrder?  @relation(fields: [onlineOrderId], references: [id])

  @@index([onlineOrderId])
  @@index([bundleId])
  @@map("BundleOrderItems")
}

model OnlineOrder {
  id                  Int              @id @default(autoincrement())
  orderNumber         String           @unique
  customerId          Int
  customer            Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingAddressId   Int?
  shippingAddress     CustomerAddress? @relation(fields: [shippingAddressId], references: [id])
  orderDate           DateTime         @default(now())
  status              OrderStatus
  paymentMethod       PaymentMethod?
  totalAmount         Decimal          @db.Decimal(10, 2)
  discount            Decimal?         @db.Decimal(10, 2)
  voucher_promo       Decimal?         @db.Decimal(10, 2)
  tax                 Decimal?         @db.Decimal(10, 2)
  shippingCost        Decimal?         @db.Decimal(10, 2)
  grandTotal          Decimal          @db.Decimal(10, 2)
  paidAmount          Decimal?         @default(0) @db.Decimal(10, 2)
  dueAmount           Decimal?         @db.Decimal(10, 2)
  note                String?
  pointsEarned        Int?
  pointsRedeemed      Int?
  pointsRedeemedValue Decimal?         @db.Decimal(10, 2)
  paymentStatus       PaymentStatus    @default(Unpaid)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  payments   Payment[]
  invoices   Invoice[] // Add this line - reverse relation

  bundleOrderItems    BundleOrderItem[]
  loyaltyTransactions LoyaltyTransaction[]
  shipment            Shipment?
  accountTransactions AccountTransaction[]

  @@index([customerId])
  @@index([shippingAddressId])
  @@index([status])
  @@map("OnlineOrders")
}

model OrderItem {
  id               Int             @id @default(autoincrement())
  onlineOrderId    Int?
  productId        Int
  sku              String?
  quantity         Int
  unitPrice        Decimal         @db.Decimal(10, 2)
  discount         Decimal?        @db.Decimal(10, 2)
  tax              Decimal?        @db.Decimal(10, 2)
  lineTotal        Decimal         @db.Decimal(10, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  invoiceItems     InvoiceItem[]
  onlineOrder      OnlineOrder?    @relation(fields: [onlineOrderId], references: [id])
  product          Product         @relation(fields: [productId], references: [id], onDelete: NoAction)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  productVariantId Int?

  @@index([productId])
  @@index([onlineOrderId])
  @@map("OrderItems")
}

model Payment {
  id                  Int          @id @default(autoincrement())
  paymentNumber       String       @unique
  orderId             Int?
  invoiceId           Int?
  customerId          Int
  paymentAmount       Decimal      @db.Decimal(10, 2)
  paymentMethod       String?
  onlinePaymentMethod String?
  paymentDate         DateTime     @default(now())
  referenceNumber     String?
  paymentNotes        String?
  customer            Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice             Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order               OnlineOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([invoiceId])
  @@map("Payments")
}

model Invoice {
  id                Int              @id @default(autoincrement())
  invoiceNumber     String           @unique
  orderId           Int
  onlineOrder       OnlineOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId        Int
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingAddressId Int?
  shippingAddress   CustomerAddress? @relation(fields: [shippingAddressId], references: [id])
  totalAmount       Decimal          @db.Decimal(10, 2)
  discount          Decimal?         @db.Decimal(10, 2)
  voucher_promo     Decimal?         @db.Decimal(10, 2)
  tax               Decimal?         @db.Decimal(10, 2)
  grandTotal        Decimal          @db.Decimal(10, 2)
  paidAmount        Decimal?         @default(0) @db.Decimal(10, 2)
  dueAmount         Decimal?         @db.Decimal(10, 2)
  paymentStatus     PaymentStatus    @default(Unpaid)
  remarks           String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  invoiceItems InvoiceItem[]
  payments     Payment[]
  saleReturns  SaleReturn[]

  @@index([orderId])
  @@index([customerId])
  @@map("Invoices")
}

model InvoiceItem {
  id          Int          @id @default(autoincrement())
  invoiceId   Int
  orderItemId Int
  quantity    Int
  unitPrice   Decimal      @db.Decimal(10, 2)
  discount    Decimal?     @db.Decimal(10, 2)
  tax         Decimal?     @db.Decimal(10, 2)
  lineTotal   Decimal      @db.Decimal(10, 2)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  SaleReturn  SaleReturn[]

  @@index([invoiceId])
  @@index([orderItemId])
  @@map("InvoiceItems")
}

model SaleReturn {
  id            Int          @id @default(autoincrement())
  returnNumber  String       @unique
  invoiceId     Int
  customerId    Int
  invoiceItemId Int?
  reason        String?
  refundAmount  Decimal?     @db.Decimal(10, 2)
  status        ReturnStatus
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceItem   InvoiceItem? @relation(fields: [invoiceItemId], references: [id])

  @@index([invoiceId])
  @@index([customerId])
  @@index([invoiceItemId])
  @@map("SaleReturns")
}

model Coupon {
  id                Int              @id @default(autoincrement())
  name              String
  code              String           @unique
  description       String?
  discountType      DiscountType
  discountValue     Decimal          @db.Decimal(10, 2)
  maxDiscountAmount Decimal?         @db.Decimal(10, 2)
  minOrderAmount    Decimal?         @db.Decimal(10, 2)
  usageLimit        Int?
  perUserLimit      Int?
  redeemedCount     Int              @default(0)
  combinable        Boolean          @default(false)
  appliesToAll      Boolean          @default(true)
  active            Boolean          @default(true)
  startAt           DateTime?
  endAt             DateTime?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  couponCategories  CouponCategory[]
  couponProducts    CouponProduct[]

  @@index([code])
  @@index([active])
  @@map("Coupons")
}

model CouponProduct {
  id        Int     @id @default(autoincrement())
  couponId  Int
  productId Int
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  id         Int      @id @default(autoincrement())
  couponId   Int
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([categoryId])
}


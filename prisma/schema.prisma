model DiscountCampaign {
  id                    Int                   @id @default(autoincrement())
  campaignCode          String                @unique
  name                  String
  description           String?
  campaignType          CampaignType          @default(FlashDeal)
  status                CampaignStatus        @default(Draft)
  discountType          DiscountType
  discountValue         Decimal               @db.Decimal(10, 2)
  maxDiscountAmount     Decimal?              @db.Decimal(10, 2)
  minOrderAmount        Decimal?              @db.Decimal(10, 2)
  appliesToAll          Boolean               @default(false)
  stockLimit            Int?
  stockUsed             Int?                  @default(0)
  perCustomerLimit      Int?
  startAt               DateTime?
  endAt                 DateTime?
  priority              Int                   @default(0)
  combinableWithCoupon  Boolean               @default(true)
  isFeatured            Boolean               @default(false)
  bannerImage           String?
  showCountdown         Boolean               @default(false)
  showBadge             Boolean               @default(true)
  badgeText             String?
  badgeColor            String?
  active                Boolean               @default(true)
  isDeleted             Boolean               @default(false)
  viewCount             Int                   @default(0)
  clickCount            Int                   @default(0)
  conversionCount       Int                   @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  discountCategories    DiscountCategory[]
  discountProducts      DiscountProduct[]
  discountSubCategories DiscountSubCategory[]

  @@index([status])
  @@index([campaignType])
  @@index([active])
  @@index([startAt, endAt])
  @@map("DiscountCampaigns")
}

model DiscountProduct {
  id         Int              @id @default(autoincrement())
  campaignId Int
  productId  Int
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([campaignId])
  @@index([productId])
  @@map("DiscountProducts")
}

model DiscountCategory {
  id         Int              @id @default(autoincrement())
  campaignId Int
  categoryId Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, categoryId])
  @@index([campaignId])
  @@index([categoryId])
  @@map("DiscountCategories")
}

model DiscountSubCategory {
  id            Int              @id @default(autoincrement())
  campaignId    Int
  subCategoryId Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  campaign      DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subCategory   SubCategory      @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subCategoryId])
  @@index([campaignId])
  @@index([subCategoryId])
  @@map("DiscountSubCategories")
}

model BundleProduct {
  id               Int               @id @default(autoincrement())
  name             String
  slug             String            @unique
  image            String
  description      String?
  discountType     DiscountType
  discountValue    Decimal           @db.Decimal(10, 2)
  price            Decimal           @db.Decimal(10, 2)
  discountAmount   Decimal           @db.Decimal(10, 2)
  finalPrice       Decimal           @db.Decimal(10, 2)
  totalVAT         Decimal           @db.Decimal(10, 2)
  status           Boolean           @default(true)
  stockQuantity    Int?              @default(0)
  minQuantity      Int?              @default(1)
  maxQuantity      Int?
  startDate        DateTime?
  endDate          DateTime?
  sortOrder        Int               @default(0)
  isFeatured       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bundleItems      BundleItem[]
  bundleOrderItems BundleOrderItem[]

  @@index([status])
  @@index([isFeatured])
  @@index([startDate, endDate])
  @@index([sortOrder])
}

model BundleItem {
  id            Int           @id @default(autoincrement())
  bundleId      Int
  productId     Int
  quantity      Int           @default(1)
  sortOrder     Int           @default(0)
  bundleProduct BundleProduct @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([productId])
  @@index([bundleId, sortOrder])
}

model Wishlist {
  id         Int      @id @default(autoincrement())
  customerId Int
  productId  Int
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model LoyaltyPoints {
  id               Int      @id @default(autoincrement())
  customerId       Int      @unique
  balance          Int      @default(0)
  lifetimeEarned   Int      @default(0)
  lifetimeRedeemed Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([customerId])
  @@index([balance])
}

model LoyaltyTransaction {
  id              Int                    @id @default(autoincrement())
  loyaltyPointsId Int
  customerId      Int
  orderId         Int?
  type            LoyaltyTransactionType
  points          Int // Positive for credit, negative for debit
  balanceAfter    Int // Balance after this transaction
  description     String?
  metadata        Json? // Store additional context
  createdAt       DateTime               @default(now())

  // Relations
  loyaltyPoints LoyaltyPoints @relation(fields: [loyaltyPointsId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order         OnlineOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([loyaltyPointsId])
  @@index([customerId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

// ***************************************
//                     CMS
// ***************************************

model Hero {
  id        Int    @id @default(autoincrement())
  title     String
  sub_title String
  image     String
  link      String
  category  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlider {
  id           Int      @id @default(autoincrement())
  badge        String?  // e.g. "BANGLADESH'S PREMIUM STORE" or "TOP OFFER"
  title        String
  sub_title    String
  image        String
  link         String?  // Button link e.g. "/product/..."
  categoryLink String?  // Optional browse categories link
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model TopPickSeason {
  id       Int    @id @default(autoincrement())
  title    String
  category String
  image    String
  link     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfferPromo {
  id          Int    @id @default(autoincrement())
  title       String
  image       String
  description String
  promo_batch String
  link        String
  position    String
  bgColor     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Clean and Production-Ready Schema

model Blog {
  id               Int      @id @default(autoincrement())
  title            String   @db.VarChar(500)
  publishDate      DateTime @map("publish_date")
  shortDescription String   @db.Text
  thumbnailImage   String   @map("thumbnail_image") @db.VarChar(1000)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sections BlogSection[]

  @@index([publishDate])
  @@index([createdAt])
  @@map("blogs")
}

model BlogSection {
  id         Int    @id @default(autoincrement())
  heading    String @db.VarChar(300)
  paragraphs Json   @db.Json
  image      String @default("") @db.VarChar(1000)

  blogId Int  @map("blog_id")

    "@react-email/render": "^2.0.0",
    "@supabase/supabase-js": "^2.86.2",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.10",
    "pdfkit": "^0.17.2",
